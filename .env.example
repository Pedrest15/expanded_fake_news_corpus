# Modelo no formato provedor/modelo.
# Exemplos: ollama/llama3.1 | anthropic/claude-sonnet-5 | openai/gpt-4o-mini
FAKEGEN_MODEL=ollama/llama3.1

# Amostragem. Temperatura baixa mantém a manchete presa ao texto da notícia.
FAKEGEN_TEMPERATURE=0
# FAKEGEN_MAX_TOKENS=256

# Tempo limite (s) e tentativas extras por chamada ao provedor.
FAKEGEN_TIMEOUT=120
FAKEGEN_MAX_RETRIES=2

# Chave do provedor escolhido (Ollama não precisa de chave).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Endereço do Ollama, se não for o padrão http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
